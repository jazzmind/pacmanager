{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jazzmind.github.io/pacmanager/schemas/artifact.schema.json",
  "title": "Portable Artifact Contract v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "pac.jazzmind.dev/v1alpha1"
    },
    "kind": {
      "enum": [
        "application",
        "agent",
        "knowledge",
        "document",
        "workflow"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "owner": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "name",
        "version",
        "owner"
      ]
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9./:_-]*@sha256:[a-f0-9]{64}$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "cpuMillis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "memoryMiB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        }
      },
      "required": [
        "image",
        "port",
        "cpuMillis",
        "memoryMiB"
      ]
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "type": {
            "enum": [
              "postgres",
              "pgvector",
              "objects"
            ]
          }
        },
        "required": [
          "name",
          "type"
        ]
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,127}$"
          },
          "operation": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,127}$"
          },
          "binding": {
            "enum": [
              "mock",
              "live"
            ]
          }
        },
        "required": [
          "name",
          "operation",
          "binding"
        ]
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inbound": {
          "const": "deny"
        },
        "outbound": {
          "const": "deny"
        }
      },
      "required": [
        "inbound",
        "outbound"
      ]
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "workload",
    "resources",
    "capabilities",
    "network"
  ],
  "$comment": "Reference validator additionally rejects duplicate resource names and capability name/operation pairs. The ID is a proposed namespace, not a claim of hosted schema availability."
}

